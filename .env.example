# Copy to .env and fill in the current values. .env is gitignored.
# Never commit a real value, and never add anything that identifies the
# machine or operator (IP addresses, device or session ids).

# --- Panchayat Nirnay (meetingonline.gov.in) ---
# The portal binds secretkey to timestamp and the pair goes stale. When the
# scraper starts failing, refresh both together.
PANCHAYAT_NIRNAY_ACCESS_KEY=
PANCHAYAT_NIRNAY_SECRET_KEY=
PANCHAYAT_NIRNAY_TIMESTAMP=

# --- Deployed chatbot (ECS) ---
# Not read by the container: the task definition pulls this from Secrets
# Manager at start. This is the source for scripts/set_openai_key.sh, which
# validates it against OpenAI, writes it to Secrets Manager and rolls the
# service. A non-empty but invalid key starts the app and then falls back on
# every question, so the script checks before it writes.
OPENAI_API_KEY=
