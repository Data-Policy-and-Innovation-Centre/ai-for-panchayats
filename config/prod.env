# Production pipeline paths. Use with `uv run --env-file config/prod.env ...`,
# or via `make run`.
#
# The mode you are in is visible in the command you type, which is the point:
# a 20-GP smoke build and a full-state build are otherwise indistinguishable
# artifacts, and only one of them belongs anywhere near a deployment.
#
# This is a convenience, not a safety property -- a convenience can be
# skipped. The safety property is scripts/build_snapshot_manifest.py, which
# refuses to pin any artifact that is not the full 6,794-GP roster, whatever
# env file produced it.
PIPELINE_RAW_ROOT=data/raw
PANCHAYAT_CANONICAL_ROOT=data/interim/canonical
PIPELINE_SNAPSHOTS=config/snapshots.yaml
PANCHAYAT_DB_PATH=data/interim/panchayat.duckdb
